global
    log stdout format raw local0
    tune.ssl.default-dh-param 2048

defaults
    mode http
    timeout connect 5s
    timeout client 50s
    timeout server 50s

# Frontend Unificato
frontend main-in
    # Ascolta su entrambe le porte
    bind *:8080
    bind *:8443 ssl crt /usr/local/etc/haproxy/certs/haproxy.pem

    # LOGICA DI REINDIRIZZAMENTO
    # Se la connessione NON è SSL (quindi arriva sulla 8080), forza HTTPS
    #http-request redirect scheme https code 301 if !{ ssl_fc }
    http-request redirect location https://localhost:8443%[path] code 301 if !{ ssl_fc }

    # ACL per lo smistamento (verranno eseguite solo se la connessione è già HTTPS)
    acl is_grafana    path_beg /grafana
    acl is_prometheus path_beg /prometheus
    
    use_backend prometheus_backend if is_prometheus
    use_backend grafana_backend    if is_grafana

backend grafana_backend
    server srv1 192.168.10.20:3000 check

backend prometheus_backend
    server srv1 192.168.10.10:9090 check
